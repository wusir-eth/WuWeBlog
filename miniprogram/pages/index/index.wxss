.home {
  padding: 24rpx;
}
.hero {
  text-align: center;
  padding: 24rpx 0 8rpx;
}
.site {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 2rpx;
}
.slogan {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}
.hot-tags {
  margin: 8rpx 0 24rpx;
  background: var(--bg-card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 20rpx 24rpx;
}
.loading,
.nomore {
  text-align: center;
  color: var(--text-sub);
  font-size: 24rpx;
  padding: 24rpx 0;
}
