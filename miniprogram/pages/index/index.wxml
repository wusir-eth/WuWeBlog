<view class="home">
  <view class="hero">
    <view class="site">WuWeBlog</view>
    <view class="slogan">记录思考 · 分享生活</view>
  </view>

  <category-bar list="{{categories}}" active="{{activeCategory}}" bind:change="onCategoryChange" />

  <view class="hot-tags" wx:if="{{hotTags.length}}">
    <view class="section-title">热门标签</view>
    <tag-list tags="{{hotTags}}" bind:select="onTagSelect" />
  </view>

  <view class="list">
    <article-card
      wx:for="{{articles}}"
      wx:key="_id"
      id="{{item._id}}"
      title="{{item.title}}"
      summary="{{item.summary}}"
      coverImage="{{item.coverImage}}"
      categoryName="{{item.categoryName}}"
      tags="{{item.tags}}"
      views="{{item.views}}"
      bind:tap="onArticleTap"
    />
  </view>

  <view class="empty" wx:if="{{!loading && articles.length === 0}}">还没有文章，去「我的」进入管理端发布第一篇吧～</view>
  <view class="loading" wx:if="{{loading}}">加载中…</view>
  <view class="nomore" wx:if="{{!loading && articles.length && !hasMore}}">— 没有更多了 —</view>
</view>
