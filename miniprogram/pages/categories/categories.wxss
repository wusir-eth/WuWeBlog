.cat-page {
  padding: 32rpx 28rpx;
}
.cat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.cat-cell {
  padding: 20rpx 36rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: var(--shadow);
}
.cat-cell-hover {
  background: #eef3f7;
}
.cat-name {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
}
