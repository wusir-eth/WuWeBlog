.detail {
  padding: 32rpx 28rpx 120rpx;
}
.head {
  border-bottom: 1rpx solid #eee;
  padding-bottom: 20rpx;
  margin-bottom: 24rpx;
}
.title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
  color: var(--text-main);
}
.meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}
.cat {
  color: var(--color-primary);
  font-weight: 500;
}
.content {
  font-size: 30rpx;
  line-height: 1.85;
  color: var(--text-main);
}
.tags {
  margin-top: 48rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag-pill {
  font-size: 24rpx;
  color: var(--color-primary);
  background: #eef3f7;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}
.back-top {
  position: fixed;
  right: 32rpx;
  bottom: 64rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  text-align: center;
  line-height: 80rpx;
  font-size: 38rpx;
  box-shadow: var(--shadow);
}
