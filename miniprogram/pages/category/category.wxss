.cat-result {
  padding: 24rpx;
}
.filter-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--bg-card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  margin-bottom: 24rpx;
}
.filter-label {
  color: var(--text-sub);
  font-size: 26rpx;
}
.filter-value {
  color: var(--color-primary);
  font-weight: 600;
  font-size: 28rpx;
  margin-left: 8rpx;
}
.filter-count {
  margin-left: auto;
  color: var(--text-sub);
  font-size: 24rpx;
}
.nomore {
  text-align: center;
  color: var(--text-sub);
  font-size: 24rpx;
  padding: 24rpx 0;
}
