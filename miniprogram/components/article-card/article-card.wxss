.article-card {
  display: flex;
  padding: 20rpx;
  margin-bottom: 24rpx;
}
.card-hover {
  transform: scale(0.99);
  opacity: 0.95;
}
.cover {
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #eef0f2;
}
.body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}
.summary {
  font-size: 24rpx;
  color: var(--text-sub);
  margin: 10rpx 0;
}
.meta {
  margin-top: auto;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}
.cat {
  color: var(--color-primary);
  font-weight: 500;
}
.tag {
  background: #eef3f7;
  color: var(--color-primary-light);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}
.views {
  margin-left: auto;
}
