.cat-bar {
  white-space: nowrap;
  padding: 16rpx 0;
}
.cat-item {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  background: #fff;
  border-radius: 999rpx;
  transition: all 0.2s ease;
}
.cat-item.active {
  color: #fff;
  background: var(--color-primary);
}
