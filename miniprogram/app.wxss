@import "style/theme.wxss";

view,
text,
scroll-view,
image {
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

/* 通用卡片 */
.card {
  background: var(--bg-card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

/* 文本省略 */
.ellipsis-1 {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 区块标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin: 8rpx 0 20rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  color: var(--text-sub);
  padding: 120rpx 0;
  font-size: 28rpx;
}

/* 按钮 */
.btn-primary {
  background: var(--color-primary);
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 18rpx 0;
  border: none;
  line-height: 1.6;
}
.btn-primary::after {
  border: none;
}
.btn-ghost {
  background: #eef3f7;
  color: var(--color-primary);
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 18rpx 0;
  border: none;
  line-height: 1.6;
}
.btn-ghost::after {
  border: none;
}
.block {
  width: 100%;
  margin-bottom: 20rpx;
}
.sm {
  display: inline-block;
  width: auto;
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  margin: 0;
}
